# ==============================================================================
# MAKO NOTIFICATION DAEMON CONFIG (Gruvbox Dark)
# ==============================================================================

# Global Geometry & Layout
max-visible=5
sort=-time
layer=overlay
anchor=top-right
width=360
height=150
margin=12
padding=12
border-size=2
border-radius=8

# Typography
font=Source Sans 3 10
markup=1
actions=1

# Default Gruvbox Colors (Normal Urgency)
background-color=#282828D9
text-color=#ebdbb2
border-color=#83a598
progress-color=over #3c3836

# Icons
icons=1
max-icon-size=48
icon-location=left

# ------------------------------------------------------------------------------
# URGENCY OVERRIDES
# ------------------------------------------------------------------------------

[urgency=low]
background-color=#282828D9
text-color=#a89984
border-color=#504945
default-timeout=4000

[urgency=normal]
background-color=#282828D9
text-color=#ebdbb2
border-color=#83a598
default-timeout=6000

[urgency=critical]
background-color=#282828F2
text-color=#fb4934
border-color=#fb4934
default-timeout=0
